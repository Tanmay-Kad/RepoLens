# ==========================================
# RepoLens AI - Environment Variables
# ==========================================

# ------------------------------------------
# Backend Server Configuration (backend/.env)
# ------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/repolens
# Comma-separated list of allowed web origins in production (in development, localhost is permitted automatically)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional at startup; required for AI summary and semantic search endpoints
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional GitHub Personal Access Token to avoid GitHub API rate limits on repo size checks
GITHUB_TOKEN=

# Directory for cloning repositories (defaults to backend/cloned-repos if unset)
CLONE_ROOT=./cloned-repos
# Hard timeout in milliseconds for repository cloning
CLONE_TIMEOUT_MS=120000
# Maximum repository size in megabytes (pre-checked via GitHub API and verified after clone)
MAX_REPO_SIZE_MB=200
# Maximum file count allowed in a cloned repository (excluding .git)
MAX_REPO_FILES=50000
# Maximum simultaneous repository analyses allowed before 503 Retry-After response
MAX_CONCURRENT_ANALYSES=2
# Number of hours before inactive cloned repositories are swept by background cleaner
CLONE_TTL_HOURS=24
# Background cleanup interval in minutes
CLEANUP_INTERVAL_MINUTES=30
# Rate limits per client IP
RATE_LIMIT_ANALYZE_PER_HOUR=10
RATE_LIMIT_AI_PER_HOUR=60
# Maximum old generation heap memory (in MB) allocated to the isolated Madge worker thread
ANALYSIS_MAX_MEMORY_MB=512
# Hard wall-clock execution timeout (in milliseconds) for worker-based graph extraction
ANALYSIS_TIMEOUT_MS=60000
# Enable if running behind a reverse proxy (e.g. Render, Railway, Nginx) so rate limiter inspects X-Forwarded-For
TRUST_PROXY=false

# ------------------------------------------
# Frontend Client Configuration (frontend/.env)
# ------------------------------------------
# Base host URL of the backend API (without trailing slash or /api path; frontend appends /api)
# In development, defaults to http://localhost:5000 if unset
VITE_API_URL=http://localhost:5000
